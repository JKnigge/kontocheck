# ── Database ──────────────────────────────────────────────
# kontocheck uses a dedicated read-only DB user
DB_HOST=192.168.1.x
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=kontocheck
DB_PASSWORD=your_password

# ── Ollama ────────────────────────────────────────────────
OLLAMA_URL=http://192.168.1.x:11434
OLLAMA_MODEL=deepseek-r1:14b

# ── Output ────────────────────────────────────────────────
OUTPUT_FOLDER=kontocheck_reports

# ── Matching ──────────────────────────────────────────────
# H4: receipt-date lower bound (days back from bank date). Receipts older
# than this are filtered out at the SQL layer and never reach LLM matching.
# Defaults to 28 if not set.
RECEIPT_DATE_WINDOW_DAYS=60

# ── regpayment ────────────────────────────────────────────
# Integer user ID from the user table — only this user's rows are queried
REGPAYMENT_USER_ID=1
